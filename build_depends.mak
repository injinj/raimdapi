# rpm BuildRequires minimums for the sibling libraries, substituted into
# rpm/raimdapi.spec by the srpm target (see .copr/Makefile); the same
# mechanism as the other injinj repos.  Bump when a newer sibling is required.
sassrv_dep := 1.45
raikv_dep := 1.43
raimd_dep := 1.33
libdecnumber_dep := 3.62
omm_dep := 1.17
